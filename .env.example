# Copy to .env and fill in. Never commit .env.

# VAST VIP pool / DNS name, with scheme and (optional) port.
VAST_S3_ENDPOINT=https://vast-s3.example.edu
VAST_S3_ACCESS_KEY=AKIA...
VAST_S3_SECRET_KEY=...

# Optional -----------------------------------------------------------------
# Default bucket for the scripts (they also accept --bucket).
VAST_S3_BUCKET=my-bucket
# Any string works for VAST but SigV4 needs one; keep the default unless told otherwise.
VAST_S3_REGION=us-east-1
# Self-signed cert? Point at the CA bundle (preferred) ...
#VAST_S3_CA_BUNDLE=/etc/ssl/certs/vast-ca.pem
# ... or disable verification (dev only).
#VAST_S3_VERIFY_SSL=false
# Connection pool size for parallel multipart transfers.
#VAST_S3_MAX_POOL_CONNECTIONS=32
